# --- Supabase (server only: the bridge is the only thing that reads these) --
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the secret key (sb_secret_...) or the legacy service_role JWT.
# The publishable/anon key returns 401 for the bridge.
SUPABASE_SERVICE_KEY=sb_secret_replace_me

# --- public URLs ----------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8081

# --- WhatsApp session -----------------------------------------------------
# SQLite file for the paired device keys. Keep it on a persistent volume:
# losing it means re-scanning the QR code.
WHATSAPP_DB=file:./data/whatsmeow.db?_foreign_keys=on
WHATSAPP_DB_DIALECT=sqlite3
# Use postgres instead if you prefer:
# WHATSAPP_DB=postgres://user:password@host:5432/whatsmeow
# WHATSAPP_DB_DIALECT=postgres

WHATSAPP_AUTO_REPLY=true
WHATSAPP_POLL_INTERVAL=3s
WHATSAPP_SEND_GAP=1500ms

# --- optional -------------------------------------------------------------
LOG_LEVEL=info
# BRIDGE_ADDR=:8081

# --- Razorpay Standard Checkout (optional) ---------------------------------
# Test keys -> rzp_test_..., live keys -> rzp_live_...
# Both stay server-side: only key_id is ever sent to the browser.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
# Shared secret for verifying Razorpay webhooks (generate one, set it in the
# Razorpay dashboard webhook URL as well).
RAZORPAY_WEBHOOK_SECRET=whsec_replace_me
